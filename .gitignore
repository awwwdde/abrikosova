# В корне отслеживаем только приложение и конфигурацию репозитория и сборки.
# Новые папки с рабочими материалами по умолчанию остаются локальными.
/*
!/.dockerignore
!/.gitattributes
!/.gitignore
!/Dockerfile
!/app/

# В app/ отслеживаем код сайта, деплой и инструменты разработки и проверок.
/app/*
!/app/.gitignore
!/app/.env.example
!/app/apps/
!/app/deploy/
!/app/docker-compose.yml
!/app/e2e/
!/app/scripts/

# Вся документация в markdown — в любой папке
*.md

# Черновики публикаций и материалы для портфолио, в том числе внутри app/.
tg-posts/
portfolio-video/

# Локальные настройки инструментов
.claude/
.vscode/
.idea/
.codex/
.agents/
.cursor/
.history/
.DS_Store
Thumbs.db

# Секреты и локальное окружение — во всём репозитории, включая old/.
.env
.env.*
!.env.example
.aws/
.ssh/
*.pem
*.key
*.p12
*.pfx

# Восстанавливаемые зависимости, сборки и кэши.
node_modules/
.next/
.turbo/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
*.tsbuildinfo
.eslintcache
/coverage/
**/coverage/
htmlcov/
.coverage
.coverage.*
coverage.xml
/dist/
/build/

# Локальные результаты браузерных проверок; сами тесты остаются в Git.
**/e2e/.auth/
**/e2e/.state/
test-results/
playwright-report/
blob-report/

# Журналы, временные файлы и выгрузки данных.
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.dump
*.sql.gz
*.sqlite
*.sqlite3

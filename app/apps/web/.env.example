# Реальные значения — только в .env (в .gitignore) или в панели Timeweb Cloud. В репозиторий не коммитить.

# Базовый URL API для серверных запросов (внутри docker-сети — http://api:8000/api/v1)
API_URL=http://localhost:8000/api/v1
# Базовый URL API для браузера
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Публичный адрес сайта — нужен для sitemap.ts/robots.ts и OG-тегов (Этап 7)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Аналитика (Этап 7), пусто = счётчик не подключается
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GA_ID=

# Базовый адрес изображений в объектном хранилище
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/abrikosova

# Тот же секрет, что у API
REVALIDATE_SECRET=

# Реальные значения — только в .env (в .gitignore) или в панели Timeweb Cloud. В репозиторий не коммитить.

# Базовый URL API для серверных запросов (внутри docker-сети — http://api:8000/api/v1)
API_URL=http://localhost:8000/api/v1
# Базовый URL API для браузера
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Публичный адрес сайта — нужен для sitemap.ts/robots.ts и OG-тегов (Этап 7)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Где работает сайт: production — индексируется; любое другое (staging, dev) —
# robots.txt запрещает всё, чтобы тестовый стенд не попал в поиск (задание 012)
SITE_ENV=development

# Подтверждение прав в Яндекс.Вебмастере и Google Search Console (content из мета-тега),
# пусто = тега нет
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Аналитика (Этап 7), пусто = счётчик не подключается
NEXT_PUBLIC_YANDEX_METRIKA_ID=
# Вебвизор (запись сессий). Поля ввода в записи скрываются в любом случае (012)
NEXT_PUBLIC_YANDEX_WEBVISOR=false
NEXT_PUBLIC_GA_ID=

# Фото и видео выдаются с сайта; закрытые каталоги API не публикует.
NEXT_PUBLIC_MEDIA_URL=/media
MEDIA_INTERNAL_URL=http://api:8000/media

# Тот же секрет, что у API
REVALIDATE_SECRET=

# Открыть разделы, которые ещё не свёрстаны по макету (lib/pages-status.ts). Только для
# разработки: по умолчанию выключено — посетитель видит «Страница в разработке». В
# docker-compose не включать, чтобы видеть сайт так же, как посетитель.
SHOW_WIP_PAGES=false

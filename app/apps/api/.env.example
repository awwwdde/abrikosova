# Реальные значения — только в .env (в .gitignore) или в панели Timeweb Cloud. В репозиторий не коммитить.

ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://abrikosova:abrikosova@localhost:5432/abrikosova
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=["http://localhost:3000"]

# JWT (Этап 3) — на проде обязательно длинная случайная строка
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# SMTP для e-mail-уведомлений администратору (Этап 2)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=

# S3 Object Storage Timeweb Cloud — изображения и файлы бэкапов (Этап 3)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Пароль сид-пользователя owner при первом деплое (дальше меняется из админки)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
# (пароль хешируется argon2 при сидировании и меняется из админки после первого входа)

# Реальные значения — только в .env (в .gitignore) или в панели Timeweb Cloud. В репозиторий не коммитить.

ENVIRONMENT=development
DEBUG=true
# Поток SQL-запросов в лог (каждый запрос — одна строка). Отдельно от DEBUG:
# включать, только когда разбираетесь с конкретным запросом.
SQL_ECHO=false

DATABASE_URL=postgresql+asyncpg://abrikosova:abrikosova@localhost:5432/abrikosova
REDIS_URL=redis://localhost:6379/0
# Прямой доступ к API: пусто. За nginx перечислите только реальные сети прокси.
# Uvicorn должен работать с --no-proxy-headers, иначе peer уже будет подменён.
TRUSTED_PROXY_NETWORKS=[]

CORS_ORIGINS=["http://localhost:3000"]
# Для QA прод-сборки (scripts/admin-qa, --base http://localhost:3200): второй origin.
# Тот же список проверяет защита /auth от CSRF (core/origin.py). На проде http:// запрещён.
# CORS_ORIGINS=["http://localhost:3000","http://localhost:3200"]

# JWT (Этап 3) — на проде обязательно длинная случайная строка
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# SMTP: уведомления администратору (Этап 2) и копия заказа покупателю (007a).
# Порт 465 — SSL сразу, 587 — STARTTLS. Пример для Яндекс 360 (почта на домене):
#   SMTP_HOST=smtp.yandex.ru
#   SMTP_PORT=465
#   SMTP_USER=zakaz@example.ru        # ящик целиком
#   SMTP_PASSWORD=                     # пароль приложения из настроек Яндекс ID, не основной
#   SMTP_FROM=zakaz@example.ru         # отправитель должен совпадать с ящиком
# Пусто — письма не уходят, заказы оформляются, в логе предупреждение
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=
# Адрес сайта в письмах: логотип и ссылка на страницу заказа
SITE_URL=http://localhost:3000

# Постоянный диск приложения (подключите отдельный том к этому пути).
MEDIA_STORAGE=database
# Только кэш при database; постоянный каталог при filesystem.
MEDIA_ROOT=/var/lib/abrikosova/media

# Только разовый перенос прежнего S3: python -m app.cli migrate-media.
# Для обычной работы эти значения не нужны.
S3_ENDPOINT_URL=
S3_PUBLIC_URL=
S3_BUCKET=abrikosova
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-1

# Пароль сид-пользователя owner при первом деплое (дальше меняется из админки)
ADMIN_SEED_EMAIL=owner@example.com
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Елена Абрикосова
# (пароль хешируется argon2 при сидировании и меняется из админки после первого входа)

# Сброс кэша фронтенда после правок в админке
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# Telegram — опциональный дополнительный канал уведомлений.
# Пустой TELEGRAM_BOT_TOKEN полностью выключает канал.
# Прокси обязателен: api.telegram.org из российских сетей недоступен напрямую.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PROXY_URL=

# Планировщик: ночной бэкап (03:30) и очистка ПДн по сроку хранения (04:00).
# Выключить, если экземпляров приложения больше одного.
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Europe/Moscow

# Часовой пояс кондитерской: «какой сейчас день» для дат заказа, сроков изготовления
# и номера заказа. Не путать с SCHEDULER_TIMEZONE — тот только про время ночных задач.
BUSINESS_TIMEZONE=Europe/Moscow

# Порты, которые docker-compose занимает НА ХОСТЕ. Меняйте, если они уже заняты
# другим проектом. Внутри docker-сети сервисы всегда общаются по своим стандартным
# портам (postgres:5432, redis:6379, api:8000) — эти переменные на это не влияют.

POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
WEB_HOST_PORT=3000
S3_HOST_PORT=9000
S3_CONSOLE_PORT=9001

# Общий секрет между api и web для сброса кэша страниц (сгенерировать длинную случайную строку)
REVALIDATE_SECRET=
